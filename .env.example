# Populated automatically by Vercel Postgres when the store is linked to this project.
# For local dev, run `vercel env pull .env.local` after linking the Postgres store.
POSTGRES_URL=

# Stripe: secret key for creating Checkout Sessions, and the signing secret
# for the /api/webhooks/stripe endpoint (from the Stripe Dashboard or
# `stripe listen --forward-to localhost:3000/api/webhooks/stripe` locally).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Slug the root URL (/) redirects to. Single-restaurant launch default is
# iyanus-kitchen (see db/seed.sql) — override only if deploying this same
# build for a different restaurant without a code change.
VITE_DEFAULT_RESTAURANT_SLUG=iyanus-kitchen
